* { font-family: "Inter", "Segoe UI", sans-serif; color:#233553; font-size:13px; }
QMainWindow,QWidget { background:transparent; }
#sidebar { background:rgba(255,255,255,205); border:1px solid rgba(255,255,255,225); border-radius:25px; min-width:218px;max-width:218px; margin:16px 0 16px 16px; }
#logo { font-size:23px; font-weight:800; color:#4a3f9d; padding:3px 11px 0; } #brandTag { color:#8a78a8;font-size:9px;font-weight:700;letter-spacing:1.6px;padding:0 14px; } #brandCredit { color:#7d7196;font-size:11px;padding:8px 13px; }
QPushButton#nav { text-align:left;border:0;background:transparent;padding:13px 14px;margin:2px 0;border-radius:14px;color:#596882;font-size:14px;font-weight:600;} QPushButton#nav:hover {background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #e9ddff,stop:1 #d9f6fa);color:#5746ad;}
QToolButton { background:rgba(255,255,255,185);border:1px solid rgba(255,255,255,220);border-radius:14px;padding:8px 11px;color:#6556b4;font-size:16px;} QToolButton:hover {background:#fff;}
QLineEdit { background:rgba(255,255,255,205); border:1px solid rgba(255,255,255,240);border-radius:18px;padding:14px 18px;font-size:14px;color:#354661;selection-background-color:#c4b5fd;} QLineEdit:focus {border:1px solid #b6a7fb;background:#fff;}
#pageTitle {font-size:30px;font-weight:800;color:#263652;padding:4px 0;} #sectionTitle {font-size:16px;font-weight:750;color:#31415d;} #muted,#heroSub {color:#71819a;}
#hero {border-radius:28px;background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 rgba(244,235,255,235),stop:.52 rgba(216,239,255,225),stop:1 rgba(211,251,242,225));border:1px solid rgba(255,255,255,245);}#heroPlace {font-size:23px;font-weight:800;color:#2a3d5e;}#heroTemp {font-size:72px;font-weight:800;color:#3e3385;letter-spacing:-3px;}#heroSub {font-size:14px;}
#metricCard,#glassCard,#forecastCard {background:rgba(255,255,255,190);border:1px solid rgba(255,255,255,230);border-radius:22px;}#metricCard:hover,#glassCard:hover,#forecastCard:hover {background:rgba(255,255,255,235);border:1px solid #d3c6ff;}#metric {font-size:24px;font-weight:800;color:#344468;}#metricSymbol {color:#846de5;font-size:18px;font-weight:700;}#aqi {font-size:25px;font-weight:800;}#pollutants {color:#6c7d95;line-height:1.7;}
#forecastCard {min-width:118px;max-width:118px;min-height:176px;}#forecastTime {color:#7b8ba2;font-weight:700;}#forecastTemp{font-size:18px;font-weight:800;color:#3d377e;}#forecastMeta{color:#74859e;font-size:11px;line-height:1.55;}#forecastRow{background:rgba(255,255,255,190);padding:15px 20px;margin:4px;border-radius:16px;color:#475875;font-weight:600;}
QComboBox {background:#fff;border:1px solid #dce6f5;border-radius:11px;padding:8px 11px;}QCheckBox{color:#60728c;}QScrollArea {border:0;background:transparent;}#mapShell {border-radius:24px;background:#fff;border:1px solid rgba(255,255,255,240);} 
