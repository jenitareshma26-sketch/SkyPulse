* { font-family:"Inter","Segoe UI",sans-serif; color:#263552; font-size:13px; } QMainWindow,QWidget{background:transparent;} #sidebar{background:rgba(255,255,255,215);border:1px solid #fff;border-radius:25px;min-width:218px;max-width:218px;margin:16px 0 16px 16px;}#logo{font-size:23px;font-weight:800;color:#4a3f9d;padding:3px 11px 0;}#brandTag,#brandCredit,#muted,#heroSub{color:#71819a;}#brandTag{font-size:9px;font-weight:700;padding:0 14px;}#brandCredit{font-size:11px;padding:8px 13px;}QPushButton#nav{text-align:left;border:0;background:transparent;padding:13px 14px;margin:2px 0;border-radius:14px;color:#596882;font-size:14px;font-weight:600;}QPushButton#nav:hover{background:#e9ddff;color:#5746ad;}QToolButton{background:#fff;border:1px solid #fff;border-radius:14px;padding:8px 11px;color:#6556b4;font-size:16px;}QLineEdit{background:rgba(255,255,255,220);border:1px solid #fff;border-radius:18px;padding:14px 18px;font-size:14px;}#pageTitle{font-size:30px;font-weight:800;color:#263652;padding:4px 0;}#sectionTitle{font-size:16px;font-weight:750;color:#31415d;}#hero{border-radius:28px;background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #f4ebff,stop:.52 #d8efff,stop:1 #d3fbf2);border:1px solid #fff;}#heroPlace{font-size:23px;font-weight:800;}#heroTemp{font-size:72px;font-weight:800;color:#3e3385;}#metricCard,#glassCard,#forecastCard{background:rgba(255,255,255,205);border:1px solid #fff;border-radius:22px;}#metricCard:hover,#glassCard:hover,#forecastCard:hover{background:#fff;border:1px solid #d3c6ff;}#metric{font-size:24px;font-weight:800;color:#344468;}#metricSymbol{color:#846de5;font-size:18px;}#aqi{font-size:25px;font-weight:800;}#pollutants{color:#6c7d95;}#forecastCard{min-width:118px;max-width:118px;min-height:176px;}#forecastTime{color:#7b8ba2;}#forecastTemp{font-size:18px;font-weight:800;color:#3d377e;}#forecastMeta{color:#74859e;font-size:11px;}#forecastRow{background:rgba(255,255,255,190);padding:15px 20px;margin:4px;border-radius:16px;color:#475875;}QComboBox{background:#fff;border:1px solid #dce6f5;border-radius:11px;padding:8px 11px;}QScrollArea{border:0;background:transparent;}#mapShell{border-radius:24px;background:#fff;border:1px solid #fff;}
